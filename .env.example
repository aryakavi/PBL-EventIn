# Database Supabase (connection pooler)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.aypwdgvqcizpsnccrfwc
DB_PASS=isi-password-database
DB_SSLMODE=require

# Supabase Storage
SUPABASE_URL=https://aypwdgvqcizpsnccrfwc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key
SUPABASE_BUCKET=image_event
SUPABASE_BUKTI_FOLDER=bukti_pembayaran

# Batas upload bukti (5 MB)
MAX_UPLOAD_BYTES=5242880

# Midtrans Snap (sandbox default)
# Ambil dari Dashboard Midtrans > Settings > Access Keys.
# Server key hanya untuk server, jangan pernah dikirim ke browser.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
# Opsional. Kosongkan untuk memakai https://<host>/midtrans-finish.php
MIDTRANS_FINISH_URL=